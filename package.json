{
  "name": "@sgtbeatdown/wolfpack-tasks",
  "version": "0.3.2",
  "description": "Memory-only endpoint-owned agent delegation for Pi and Claude Code through Wolfpack relay v2.",
  "module": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/almogdepaz/wolfpack-tasks.git"
  },
  "keywords": [
    "pi-package",
    "pi",
    "agent",
    "tasks"
  ],
  "files": [
    "README.md",
    "docs",
    "src",
    "skills",
    "tsconfig.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.80.10",
    "@earendil-works/pi-coding-agent": "^0.80.10",
    "@earendil-works/pi-tui": "^0.80.10",
    "@types/bun": "^1.3.14",
    "typebox": "^1.3.6",
    "typescript": "^7.0.2"
  },
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build:claude": "bun scripts/build-claude.ts"
  },
  "type": "module"
